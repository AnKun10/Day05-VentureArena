# Copy thành .env (KHÔNG commit .env — .gitignore đã chặn) — 02-guide.md §3.4 luật an toàn: không commit API key.
#
# LƯU Ý: thư mục này hiện có HAI bot (xem README.md) — biến của cả hai gộp chung ở đây.
# Bot nào không dùng biến của bot kia thì cứ để trống, không ảnh hưởng.

# ---------- Dùng chung cho cả hai bot ----------

# Token bot Discord — Developer Portal > Applications > Bot > Reset Token
DISCORD_TOKEN=

# ID server test — điền để slash command sync ngay lập tức (global sync mất tới 1h).
# Bật chế độ nhà phát triển trong Discord > chuột phải server > "Copy Server ID".
DISCORD_GUILD_ID=

# ---------- Bot A: main.py (cogs/ + ingestion/ + decision.py) ----------

# URL Web UI của Hải (mặc định đã đúng cho `npm run dev` local)
WEB_UI_URL=http://localhost:5173

# URL backend FastAPI (codebase/backend) — decision.py sẽ gọi khi swap sang RAG thật
BACKEND_API_URL=http://localhost:8000

# Đường dẫn file SQLite (mặc định: codebase/bot/bot.sqlite3)
BOT_DB_PATH=

# ---------- Bot B: run_bot.py (companion_discord/) ----------

COMPANION_API_URL=http://127.0.0.1:8000
COMPANION_UI_URL=http://127.0.0.1:5173
COMPANION_DB_PATH=../../data/companion.sqlite3
COMPANION_SOURCES_PATH=./sources.yaml
TA_ROSTER_PATH=../data/ta_roster.yaml
