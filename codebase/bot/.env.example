# Copy thành .env (KHÔNG commit .env — .gitignore đã chặn) — 02-guide.md §3.4 luật an toàn: không commit API key.

# Token bot Discord — Developer Portal > Applications > Bot > Reset Token
DISCORD_TOKEN=

# ID server test — điền để slash command sync ngay lập tức (global sync mất tới 1h).
# Bật chế độ nhà phát triển trong Discord > chuột phải server > "Copy Server ID".
DISCORD_GUILD_ID=

# URL Web UI của Hải (mặc định đã đúng cho `npm run dev` local)
WEB_UI_URL=http://localhost:5173

# URL backend FastAPI của Nghĩa (chưa dùng ở bản mock — để sẵn cho lúc swap decision.py -> API thật)
BACKEND_API_URL=http://localhost:8000

# Đường dẫn file SQLite (mặc định: codebase/bot/bot.sqlite3)
BOT_DB_PATH=