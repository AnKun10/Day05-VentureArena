# Copy thành .env.local để UI gọi backend THẬT thay vì mock.
# (.env.local nằm trong .gitignore — mỗi máy tự tạo.)
#
# Bỏ file này đi / để VITE_USE_MOCK=true thì UI chạy mock (src/api/mockAsk.js) —
# vẫn là phương án B lúc demo nếu backend chết hoặc hết credit (MASTERPLAN.md §9).

VITE_USE_MOCK=false
VITE_API_BASE=http://localhost:8000
