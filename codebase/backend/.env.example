# Companion backend — copy thành .env và điền giá trị thật.
# .env đã nằm trong .gitignore — KHÔNG commit key thật.

# --- OpenAI (bắt buộc cho NewsEnricher) ---
OPENAI_API_KEY=sk-...

# --- Tavily Image Search (tool search_image; thiếu thì ảnh dùng placeholder) ---
TAVILY_API_KEY=tvly-...

# --- Discord (chỉ cần khi --source discord; seed mode không cần) ---
DISCORD_TOKEN=
# Cách 1 (khuyến nghị): chỉ cần GUILD ID — bot tự tìm 3 kênh forum theo tên
# (chia-sẻ / bài-học / tài-nguyên, tự bỏ emoji + dấu khi so khớp).
# Bật Developer Mode trong Discord → chuột phải tên server → Copy Server ID.
DISCORD_GUILD_ID=
# Cách 2 (override — chỉ điền khi tên kênh khác chuẩn hoặc muốn chỉ định cứng):
DISCORD_CHANNEL_CHIA_SE=
DISCORD_CHANNEL_BAI_HOC=
DISCORD_CHANNEL_TAI_NGUYEN=

# --- Storage ---
COMPANION_DB=companion.db

# --- Model ---
ENRICH_MODEL=gpt-5-mini
EMBED_MODEL=text-embedding-3-small
QDRANT_PATH=qdrant_data
